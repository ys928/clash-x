{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["src/polyfills/*.js!"],
  "project": ["src/**/*.{js,jsx,ts,tsx,sass,scss}!", "scripts/**/*.{js,mjs}!"],
  "include": [
    "files",
    "dependencies",
    "devDependencies",
    "unlisted",
    "unresolved",
    "binaries",
    "exports",
    "types",
    "duplicates",
    "cycles"
  ],
  "eslint": {
    "config": [".config/eslint.config.ts"]
  },
  "vite": {
    "config": [".config/vite.config.mts"]
  },
  "vitest": {
    "config": [".config/vitest.config.mts"]
  },
  "lefthook": {
    "config": [".config/lefthook.yml"]
  },
  "ignoreBinaries": ["rustc"],
  "ignoreIssues": {
    "src/types/generated/**": ["exports", "types"]
  },
  "cycles": {
    "dynamicImports": true
  }
}
