#!/usr/bin/env bash
set -euo pipefail

if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
  echo "No upstream found, skipping diff-based checks"
  exit 0
fi

# Clippy when Rust sources / manifests changed since upstream
if ! git diff '@{u}..HEAD' --quiet -- '*.rs' Cargo.toml Cargo.lock; then
  cargo clippy --all-targets --all-features -- -D warnings
fi

# Frontend typecheck + knip when frontend sources changed since upstream
if ! git diff '@{u}..HEAD' --quiet -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.css' '*.scss' '*.html'; then
  if ! command -v pnpm >/dev/null 2>&1; then
    echo "❌ pnpm is required for pre-push checks."
    exit 1
  fi
  pnpm typecheck
  pnpm knip:check
fi
