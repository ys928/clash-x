#!/usr/bin/env bash
set -euo pipefail

if ! command -v pnpm >/dev/null 2>&1; then
  echo "❌ pnpm is required for pre-commit checks."
  exit 1
fi

# Rust format when Rust sources / manifests are staged
if ! git diff --cached --quiet -- '*.rs' Cargo.toml Cargo.lock; then
  cargo fmt -- --emit=files
fi

# Align i18n keys / regenerate types when locale files are staged
if ! git diff --cached --quiet -- src/locales crates/clash-verge-i18n/locales; then
  pnpm i18n:format
  pnpm i18n:types
  git add src/locales crates/clash-verge-i18n/locales src/types/generated
fi

# Frontend lint/format via lint-staged
if ! git diff --cached --quiet -- '*.js' '*.jsx' '*.ts' '*.tsx' '*.json' '*.css' '*.scss' '*.html'; then
  pnpm exec lint-staged
fi
